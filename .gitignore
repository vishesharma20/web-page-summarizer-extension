# --- Node / npm (used by the backend's wrangler CLI) ---
node_modules/
npm-debug.log*
yarn-error.log*
package-lock.json

# --- Cloudflare Wrangler local state & secrets ---
backend/.wrangler/
.wrangler/
backend/.dev.vars
.dev.vars

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor junk ---
.vscode/
*.swp

# --- Build/distribution artifacts (don't commit the packaged zip) ---
*.zip
dist/

